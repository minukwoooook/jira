# .env.example
ORACLE_DSN=oracle.internal.example.com:1521/ORCL
ORACLE_USER=jira_dash
ORACLE_PASSWORD=set_me_on_prem
# Oracle Instant Client 설치 경로. thick 모드 필수(DPY-3015 회피, design.md §5.7).
# 시스템 라이브러리 경로(ldconfig/LD_LIBRARY_PATH)에 이미 등록돼 있으면 이 줄 자체를
# 지운다 — 값을 채우지 않은 채로 남기면 그 문자열이 그대로 lib_dir로 전달되어 실패한다.
ORACLE_CLIENT_LIB_DIR=/usr/lib/oracle/21/client64/lib
DISPLAY_TZ=Asia/Seoul
JIRA_SITE_A_TOKEN=set_me_on_prem
